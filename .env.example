# ==========================================
# Aegis Browser - Local Environment Configuration
# ==========================================
# NOTE: DO NOT commit your actual .env file or private keys to git repository.
# .env is already included in .gitignore.

# Tauri Private Signing Key (for signing updater release artifacts locally)
# Copy the entire contents of your generated private key file (e.g. aegis.key)
TAURI_SIGNING_PRIVATE_KEY=""

# Optional: Password if your private key is encrypted with a password
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# Feedback / Report Worker (Dev Console → Report / Request modal)
# Hardcoded default: https://aegis-feedback.leeroi-c25.workers.dev
# Only set this to override it.
# Example: VITE_FEEDBACK_WORKER_URL="https://aegis-feedback.leeroi-c25.workers.dev"
VITE_FEEDBACK_WORKER_URL=""
